{
  "name": "lift-sdlc",
  "version": "0.27.2",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "test": "node --test 'scripts/**/*.test.js' 'skills/**/*.test.js' 'hooks/**/*.test.js'",
    "lint": "eslint scripts skills hooks",
    "check:refs": "node scripts/ci/validate-skill-script-refs.js",
    "check:plugin": "node scripts/ci/validate-plugin-schema.js",
    "check:discovery": "node scripts/ci/validate-discovery.js",
    "check:tiers": "node scripts/ci/validate-cost-tiers.js",
    "check:all": "npm run check:refs && npm run check:plugin && npm run check:discovery && npm run check:tiers",
    "test:learning-loop": "node scripts/ci/simulate-learning-loop.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0"
  }
}
