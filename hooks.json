{
  "git-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-git-guard.js"
          }
        ]
      }
    ]
  },
  "question-suppression": {
    "PreToolUse": [
      {
        "matcher": "ask_question|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/question-suppression.js"
          }
        ]
      }
    ]
  },
  "session-context": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/session-start.js"
      }
    ]
  },
  "drift-nudge": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/post-tool-nudge.js"
      }
    ]
  },
  "stop-block": {
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop-block.js"
      }
    ]
  },
  "state-save": {
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop-state-save.js"
      }
    ]
  },
  "validation-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-validate.js"
          }
        ]
      }
    ]
  }
}
