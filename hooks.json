{
  "git-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-git-guard.js"
          }
        ]
      }
    ]
  },
  "question-suppression": {
    "PreToolUse": [
      {
        "matcher": "ask_question|ask_user|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/question-suppression.js"
          }
        ]
      }
    ]
  },
  "session-context": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/session-start.js"
      }
    ]
  },
  "drift-nudge": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/post-tool-nudge.js"
      }
    ]
  },
  "stop-block": {
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop-block.js"
      }
    ]
  },
  "state-save": {
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop-state-save.js"
      }
    ]
  },
  "plan-integrity-guard": {
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop-plan-integrity.js"
      }
    ]
  },
  "jira-write-guard": {
    "PreToolUse": [
      {
        "matcher": ".*(createJiraIssue|editJiraIssue|addCommentToJiraIssue).*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-jira-write-guard.js"
          }
        ]
      }
    ]
  },
  "validation-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file|create_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-validate.js"
          }
        ]
      }
    ]
  }
}
